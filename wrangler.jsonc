{
	"name": "looseends",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-15",
	// Per-IP throttle on /api/series. A full uncached library is 8 requests
	// over ~90s; a cached one is 8 requests in about two seconds. 30 per
	// minute leaves room for a few reloads and stops a script cold.
	// Periods may only be 10 or 60 seconds.
	"ratelimits": [
		{
			"name": "SERIES_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 60 }
		},
		// Per-IP throttle on /api/ai-series (the experimental AI lookup). The
		// page asks once to read the cache, then for one series at a time, and
		// a lookup takes ten seconds or more: an honest visitor makes four or
		// five requests a minute. 12 leaves room for cached answers, which
		// come back at once, and for a reload.
		{
			"name": "AI_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 12, "period": 60 }
		}
	],

	// Workers AI reads the pages the AI lookup finds (see worker/ai.ts). On
	// the Workers Free plan the first 10,000 neurons a day are free, and
	// past that the call fails rather than bills. The binding name must stay
	// "AI".
	"ai": {
		"binding": "AI"
	},

	// Shared cache of public series metadata. The binding name must stay "DB":
	// that is what worker/index.ts reads. `wrangler d1 create` suggests a block
	// naming the binding after the database, which does not match.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "looseends-cache",
			"database_id": "65ebce26-94dc-47f8-996e-8d83f5060898",
			"remote": true
		}
	],
	// Persists logs for 3 days on the free plan, 200k events/day, queryable in
	// the dashboard. Without this you only see problems while `wrangler tail`
	// happens to be running.
	// Cloudflare Turnstile guards /api/series (see worker/pass.ts). The site
	// key is public and read by the page via GET /api/pass; the secret is
	// set with `npx wrangler secret put TURNSTILE_SECRET_KEY`. Until both
	// exist, lookups answer "not configured" — deliberately closed, not open.
	// Paste the site key from the Turnstile dashboard between the quotes.
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFLLcNQh65jnRhR4",
		// Requests to Hardcover allowed per UTC day (their free plan: 5,000).
		// At the cap, series not yet cached wait until midnight UTC.
		"HARDCOVER_DAILY_BUDGET": "4000",
		// Web searches the AI lookup may make per UTC day, for all visitors
		// together. A lookup is one search, sometimes two. Tavily's free plan
		// is 1,000 a month; 30 a day keeps a month inside it. The search key
		// is a secret: `npx wrangler secret put TAVILY_KEY`.
		"AI_DAILY_BUDGET": "30"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The Worker sees every request first and hands anything that is not
		// /api/* to ASSETS. Without this, the asset server answers /api/series
		// itself — which is what returned 405, since static files only do GET.
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	}
}