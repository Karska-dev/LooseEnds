# Required. A Hardcover personal access token, used server-side only.
# hardcover.app > account settings > Hardcover API
#
# Paste it with no "Bearer " in front — the code adds that.
HARDCOVER_TOKEN=

# Optional: the experimental AI lookup (the "AI" tab). Without these the
# tab says it is not configured and everything else works as before.
#
# A Tavily API key, used server-side only. tavily.com, free plan, no card:
# 1,000 searches a month. A lookup is one search, sometimes two.
TAVILY_KEY=

# In dev the pages are read by a local model through Ollama (ollama.com);
# production uses Workers AI instead. Pull the model first:
#   ollama pull qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434

# Optional, and only for `npm run ai-explain -- --all --workers-ai`: the
# benchmark asking Cloudflare's model from a laptop. The deployed Worker
# needs neither; it reaches the model through its AI binding.
# Cloudflare dashboard > Workers AI > "Use REST API" shows the account ID
# and creates a token with Workers AI Read and Edit.
# Not named CLOUDFLARE_*: Wrangler would take a token under that name as its
# own login and fail on every other command.
WORKERS_AI_ACCOUNT_ID=
WORKERS_AI_API_TOKEN=
